{
  "name": "flowread",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @flowread/server --filter @flowread/web dev",
    "dev:web": "pnpm --filter @flowread/web dev --open",
    "dev:server": "pnpm --filter @flowread/server dev",
    "build": "pnpm --filter @flowread/web build",
    "build:all": "pnpm -r --filter ./packages/** --filter ./apps/server --filter ./apps/web build",
    "start": "pnpm --filter @flowread/server start",
    "preview": "pnpm build && pnpm start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "icons": "python scripts/make-icons.py",
    "desktop:dev": "pnpm --filter @flowread/desktop dev",
    "desktop:pack": "pnpm --filter @flowread/desktop build",
    "desktop:check": "cargo check --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "android:build": "node scripts/build-android.mjs",
    "android:dev": "pnpm --filter @flowread/desktop exec tauri android dev",
    "android:init": "pnpm --filter @flowread/desktop exec tauri android init",
    "docker:up": "docker compose up -d --build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide",
      "sharp"
    ]
  },
  "devDependencies": {
    "playwright-core": "^1.64.1"
  }
}
