{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowRead",
  "version": "0.1.0",
  "identifier": "is.flowread.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../web dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm --dir ../web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FlowRead",
        "width": 1360,
        "height": 900,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "AI RSS reader",
    "longDescription": "FlowRead is a local-first RSS reader with AI summaries and bilingual translation. Feeds, settings and articles live in a local SQLite database."
  }
}
