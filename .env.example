# Server
PORT=8787
HOST=0.0.0.0
# Directory with the built web app (enables single-port deployment)
# WEB_DIR=./apps/web/dist

# Allow fetching private-network feeds (localhost, 10/8, 192.168/16, …).
# Keep 0 unless you trust every client that can reach this server.
ALLOW_PRIVATE_NETWORK=0

# --- Web dev server -------------------------------------------------------
# Where Vite proxies /api during development
# VITE_API_TARGET=http://127.0.0.1:8787
